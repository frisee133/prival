{
    admin off
    auto_https off
    log {
        output discard
    }
}
http://{$TUNNEL_HOST}:18880 {
    bind 127.0.0.1
    handle /internal/* {
        respond 404
    }
    @signal path /rtc /rtc/*
    handle @signal {
        forward_auth {$APP_UPSTREAM:127.0.0.1:18080} {
            uri /internal/rtc-auth
        }
        reverse_proxy {$SFU_UPSTREAM:127.0.0.1:17881}
    }
    handle {
        reverse_proxy {$APP_UPSTREAM:127.0.0.1:18080} {
            flush_interval -1
        }
    }
}
