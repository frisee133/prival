{
    admin off
    auto_https disable_redirects
    skip_install_trust
    log {
        output discard
    }
}

https://{$PRIVATE_IP}:{$PRIVATE_PORT:18443} {
    bind {$PRIVATE_IP}
    tls internal
    handle /internal/* {
        respond 404
    }
    @signal path /rtc /rtc/*
    handle @signal {
        forward_auth {$APP_UPSTREAM:127.0.0.1:18080} {
            uri /internal/rtc-auth
        }
        reverse_proxy {$SFU_UPSTREAM:127.0.0.1:17881}
    }
    handle {
        reverse_proxy {$APP_UPSTREAM:127.0.0.1:18080}
    }
}

