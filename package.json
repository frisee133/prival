{
  "name": "prival-voice",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "tsx server/index.ts",
    "migrate": "tsx server/cli.ts migrate",
    "owner": "tsx server/cli.ts owner",
    "build": "tsc --noEmit && tsc -p server/tsconfig.json && vite build && node scripts/compress-audio.mjs",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --test tests/model.test.mjs tests/voice-gate.test.mjs",
    "test:audio": "node tests/audio-browser.mjs",
    "test:browser": "node tests/social-browser.mjs",
    "test:api": "node tests/social-api.mjs",
    "start": "node dist/server/index.js",
    "windows:build": "node scripts/windows.mjs --package"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.11",
    "@fontsource-variable/rubik": "5.3.0",
    "@workadventure/noise-suppression": "0.2.0",
    "fastify": "5.12.8",
    "livekit-client": "2.24.0",
    "livekit-server-sdk": "2.19.3",
    "lucide-react": "0.552.0",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.3.1",
    "playwright-core": "1.65.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
